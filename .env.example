# Docker Compose only. Generate both values locally; never commit .env.
# Use URL-safe characters for POSTGRES_PASSWORD (it is interpolated into a URL).
POSTGRES_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional, server-side catalog operations only.
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=10
YOUTUBE_MAX_RETRIES=2
