CORS_ORIGINS=http://localhost:3000
# Server-only YouTube Data API v3 credentials; needed only for catalog requests.
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=10
YOUTUBE_MAX_RETRIES=2
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Local HTTP development only; use true with HTTPS in production (the default).
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://asmr:change_me@localhost:5432/asmr
# Optional: dedicated test database; tests create and remove an isolated schema.
# TEST_DATABASE_URL=postgresql+psycopg://asmr:change_me@localhost:5432/asmr_test
